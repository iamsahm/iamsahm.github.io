<style>
  .about {
    background: var(--color-blue);
    color: var(--color-text-light);
    flex-direction: column;
  }

  .left-text {
    font-size: var(--font-size-h2);
    padding: var(--spacing-lg);
  }

  .left-text p {
    margin: 0;
  }

  .left-text a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .stack-trigger {
    position: relative;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 4px;
    display: inline-block;
  }

  .stack-logos {
    position: absolute;
    left: 0;
    top: 100%;
    display: none;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    background: #ffffff;
    border-radius: 8px;
    margin-top: 0.5rem;
    z-index: 10;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    font-size: 1rem;
  }

  .stack-trigger:hover .stack-logos {
    display: flex;
  }

  .logos-main {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  .logos-secondary {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  .stack-logos svg.logo-lg {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
  }

  .stack-logos svg.logo-sm {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }
</style>
